pipeline {
    agent any

    stages {
        stage('Run Tests') {
            steps {
                script {
                    echo 'Running tests using docker-compose...'
                    
                    // Run tests inside the container defined in docker-compose.yml
                    // We mount the current workspace src and tests to override the image's code
                    // while preserving the models located at /app/01_RAG/models in the image.
                    // We use --rm to clean up the container after execution.
                    
                    sh '''
                        docker-compose run --rm \
                        -v ${WORKSPACE}/src:/app/01_RAG/src \
                        -v ${WORKSPACE}/tests:/app/01_RAG/tests \
                        linux_with_cuda_complete \
                        /bin/bash -c " \
                            .venv/bin/python tests/test_full.py && \
                            .venv/bin/python tests/test_reranking.py && \
                            .venv/bin/python tests/test_load_model.py && \
                            .venv/bin/python tests/test_similarity_filter.py && \
                            .venv/bin/python tests/test_inference.py --model Qwen3-8B-Q5_K_M --mode all --include-environment \
                        "
                    '''
                }
            }
        }
    }
}
