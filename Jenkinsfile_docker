pipeline {
    agent {
        docker {
            // Use the project's existing image which has all dependencies and CUDA support
            image 'linux_with_cuda_complete:latest'
            // Pass GPU access to the container
            args '--gpus all --entrypoint=""'
            reuseNode true
        }
    }

    environment {
        // Point to the models baked into the image at /app/01_RAG/models
        HF_HOME = '/app/01_RAG/models'
        WORKDIR = '/app/01_RAG/tests'
    }

    stages {
        stage('Run Tests') {
            steps {
                script {
                    echo 'Running tests inside linux_with_cuda_complete container...'
                    
                    // Make scripts executable
                    sh 'chmod +x tests/*.sh'
                    
                    // Run test scripts
                    sh './tests/run_test_full.sh'
                    sh './tests/run_test_reranking.sh'
                    sh './tests/run_test_load_model.sh'
                    sh './tests/run_test_similarity_filter.sh'
                    sh './tests/run_test_inference.sh'
                    sh './tests/run_test_inference_env.sh'
                }
            }
        }
    }
}
