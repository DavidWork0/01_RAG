pipeline {
    agent {
        docker {
            image 'linux_with_cuda_complete:latest'
            args '--gpus all --entrypoint=""'
            reuseNode true
        }
    }

    environment {
        GIT_CONFIG_PARAMETERS = 'core.autocrlf=false'
        HF_HOME = '/app/01_RAG/models/huggingface'
        HUGGINGFACE_HUB_CACHE = '/app/01_RAG/models/huggingface'
        TRANSFORMERS_CACHE = '/app/01_RAG/models/huggingface'
        RAG_MODEL_CACHE_DIR = '/app/01_RAG/models/huggingface'
        RAG_PROJECT_ROOT_OVERRIDE = '/app/01_RAG'
        RAG_LLM_MODELS_DIR = '/app/01_RAG/models/llamacpp'
        WORKDIR = '/app/01_RAG/tests'
        
        // GitHub integration
        GITHUB_CREDENTIALS = credentials('github-api-token')
        GITHUB_API_URL = 'https://api.github.com'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo 'Checking out repository...'
                    checkout scm
                    
                    // Extract repository and commit info
                    sh '''
                        git log -1 --oneline
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    echo 'Running tests inside linux_with_cuda_complete container...'
                    
                    try {
                        sh '/app/01_RAG/.venv/bin/python tests/test_full.py'
                        sh '/app/01_RAG/.venv/bin/python tests/test_load_model.py'
                        sh '/app/01_RAG/.venv/bin/python tests/test_reranking.py'
                        sh '/app/01_RAG/.venv/bin/python tests/test_similarity_filter.py'
                        sh '/app/01_RAG/.venv/bin/python tests/test_inference.py --model Qwen3-8B-Q5_K_M --mode all --include-environment'
                        
                        echo 'All tests passed!'
                    } catch (Exception e) {
                        echo "Test failed: ${e.message}"
                        throw e
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo 'Preparing test report...'
                sh '''
                    # Collect test logs if they exist
                    if [ -d "tests/logs" ]; then
                        ls -la tests/logs/
                    fi
                '''
            }
        }
        
        success {
            script {
                echo 'Tests passed - reporting success to GitHub...'
                sh '''
                    COMMIT_SHA=$(git rev-parse HEAD)
                    REPO_FULL_NAME=$(git config --get remote.origin.url | sed 's|.*github.com/||;s|.git$||')
                    
                    curl -X POST \\
                        -H "Authorization: token ${GITHUB_CREDENTIALS}" \\
                        -H "Accept: application/vnd.github.v3+json" \\
                        "${GITHUB_API_URL}/repos/${REPO_FULL_NAME}/statuses/${COMMIT_SHA}" \\
                        -d "{
                            \\\"state\\\": \\\"success\\\",
                            \\\"description\\\": \\\"Jenkins Docker tests passed\\\",
                            \\\"context\\\": \\\"jenkins/docker-tests\\\",
                            \\\"target_url\\\": \\\"${BUILD_URL}\\\"
                        }"
                    
                    echo "GitHub status updated: SUCCESS"
                '''
            }
        }
        
        failure {
            script {
                echo 'Tests failed - reporting failure to GitHub...'
                sh '''
                    COMMIT_SHA=$(git rev-parse HEAD)
                    REPO_FULL_NAME=$(git config --get remote.origin.url | sed 's|.*github.com/||;s|.git$||')
                    
                    curl -X POST \\
                        -H "Authorization: token ${GITHUB_CREDENTIALS}" \\
                        -H "Accept: application/vnd.github.v3+json" \\
                        "${GITHUB_API_URL}/repos/${REPO_FULL_NAME}/statuses/${COMMIT_SHA}" \\
                        -d "{
                            \\\"state\\\": \\\"failure\\\",
                            \\\"description\\\": \\\"Jenkins Docker tests failed\\\",
                            \\\"context\\\": \\\"jenkins/docker-tests\\\",
                            \\\"target_url\\\": \\\"${BUILD_URL}\\\"
                        }"
                    
                    echo "GitHub status updated: FAILURE"
                '''
            }
        }
    }
}