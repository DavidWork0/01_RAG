                    ]
                    def databases1 = [
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_500_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_500_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_750_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_750_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1000_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1000_200_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1000_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1000_350_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1000_450_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1250_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1250_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1250_350_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1250_450_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1500_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1500_200_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1500_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1500_350_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_1500_450_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_2000_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_2000_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_2000_350_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_2000_450_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_3000_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_3000_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_3000_350_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_3000_450_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_4000_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_4000_250_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_4000_350_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_4000_450_cleaned',
                        'chroma_db_by_sentence_Qwen_Qwen3-Embedding-0.6B_1024_500_cleaned',
                        'chroma_db_by_sentence_Qwen_Qwen3-Embedding-0.6B_1024_1000_cleaned',
                        'chroma_db_by_sentence_Qwen_Qwen3-Embedding-0.6B_1024_1500_cleaned',
                        'chroma_db_by_sentence_Qwen_Qwen3-Embedding-0.6B_1024_2000_cleaned',
                        'chroma_db_by_sentence_Qwen_Qwen3-Embedding-0.6B_1024_3000_cleaned'
                    ]
                    def databases = [
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_500_150_cleaned',
                        'chroma_db_fixed_size_Qwen_Qwen3-Embedding-0.6B_1024_500_250_cleaned'
                    ]
                    
                    // Define models to test
                    def models = [
                        'InternVL3_5-2B-Q8_0',
                        'InternVL3_5-8B-Q4_K_M',
                        'InternVL3-2B-Instruct-Q5_K_M',
                        'Qwen3-4B-Instruct-2507-Q8_0'
                    ]
                    
                    def totalTests = databases.size() * models.size()
                    def currentTest = 0
                    
                    echo "=========================================="
                    echo "Starting Database Sweep Testing Pipeline"
                    echo "Databases: ${databases.size()}"
                    echo "Models: ${models.size()}"
                    echo "Total test combinations: ${totalTests}"
                    echo "=========================================="
                    
                    def testResults = [:]
                    def failedTests = []
                    
                    // Nested loop: for each database, test all models
                    for (int d = 0; d < databases.size(); d++) {
                        def database = databases[d]
                        
                        echo "\n"
                        echo "=========================================="
                        echo "Database = ${database} (${d + 1}/${databases.size()})"
                        echo "=========================================="
                        
                        for (int m = 0; m < models.size(); m++) {
                            def model = models[m]
                            currentTest++
                            def testId = "db_${database}_${model}"
                            
                            echo "\n"
                            echo "==========================================  "
                            echo "Test ${currentTest}/${totalTests}"
                            echo "Database: ${database} | Model: ${model}"
                            echo "=========================================="
                            
                            try {
                                // Stage 1: Update DEFAULT_DB_PATH in model_config.py
                                stage("${currentTest}. Config - DB=${database}") {
                                    echo "Updating DEFAULT_DB_PATH to ${database}..."
                                    sh """
                                        sed -i 's|^DEFAULT_DB_PATH = .*|DEFAULT_DB_PATH = "data/output/${database}"|' src/model_config.py
                                        echo "Current DEFAULT_DB_PATH:"
                                        grep "^DEFAULT_DB_PATH" src/model_config.py
                                    """
                                    echo "✅ Configuration updated"
                                }
                                
                                // Stage 2: Run Inference Tests
                                stage("${currentTest}. Inference - ${model}") {
                                    echo "Running inference with Database=${database}, Model=${model}..."
                                    sh "/app/01_RAG/.venv/bin/python tests/test_inference.py --model ${model} --mode all --include-environment"
                                    echo "✅ Inference completed"
                                }
                                
                                // Stage 3: Evaluate Answers
                                stage("${currentTest}. Evaluate - ${model}") {
                                    echo "Evaluating answers..."
                                    
                                    // Generate timestamp for unique filename
                                    def timestamp = sh(script: 'date +%Y%m%d_%H%M%S', returnStdout: true).trim()
                                    def evalFile = "tests/logs/answer_evaluation_results_${database}_${model}_${timestamp}.json"
                                    
                                    sh """
                                        /app/01_RAG/.venv/bin/python src/answer_evaluator.py \
                                            --gold-standard data/test/sonar_pro_gold_standard_dataset.json \
                                            --inference-log tests/logs/inference_log.jsonl \
                                            --num-inference-eval 1 \
                                            --max-questions 10 \
                                            --output-json ${evalFile}
                                    """
                                    echo "✅ Evaluation completed: ${evalFile}"
                                    
                                    // Store eval file path for use in upload stage
                                    testResults["${testId}_evalfile"] = evalFile
                                }
                                
                                // Stage 4: Upload to Neptune
                                stage("${currentTest}. Upload - ${model}") {
                                    if (env.NEPTUNE_API_TOKEN != null && env.NEPTUNE_PROJECT != null) {
                                        echo "Uploading results to Neptune.ai..."
                                        
                                        try {
                                            // Upload inference test results
                                            sh 'bash jenkins_neptune_upload.sh'
                                            
                                            // Get the evaluation file path from previous stage
                                            def evalFile = testResults["${testId}_evalfile"]
                                            
                                            // Upload answer evaluation metrics with database tag
                                            sh """
                                                /app/01_RAG/.venv/bin/python src/neptune_uploader.py \
                                                    --upload-evaluation \
                                                    --evaluation-file ${evalFile} \
                                                    --tags jenkins evaluation build-${BUILD_NUMBER} model-${model} database-${database}
                                            """
                                            
                                            echo "✅ Neptune upload completed"
                                        } catch (Exception uploadError) {
                                            echo "⚠️  Warning: Neptune upload failed: ${uploadError.message}"
                                            echo "Continuing with pipeline..."
                                        }
                                    } else {
                                        echo "ℹ️  Neptune credentials not configured, skipping upload"
                                    }
                                }
                                
                                testResults[testId] = "SUCCESS"
                                echo "✅ Test ${testId} completed successfully"
                                
                            } catch (Exception e) {
                                testResults[testId] = "FAILED"
                                failedTests.add(testId)
                                echo "❌ Failed test ${testId}: ${e.message}"
                                echo "Continuing with next test..."
                            }
                        }
                    }
                    
                    // Print final summary
                    echo "\n"
                    echo "=========================================="
                    echo "DATABASE SWEEP TESTING SUMMARY"
                    echo "=========================================="
                    echo "Total tests: ${totalTests}"
                    echo "Successful: ${testResults.count { it.value == 'SUCCESS' }}"
                    echo "Failed: ${failedTests.size()}"
                    echo ""
                    
                    if (failedTests.size() > 0) {
                        echo "Failed tests:"
                        failedTests.each { test ->
                            echo "  ❌ ${test}"
                        }
                        echo ""
                        echo "⚠️  Some tests failed but pipeline completed"
                    } else {
                        echo "✅ All tests passed successfully!"
                    }
                    echo "=========================================="
                    
                    // Detailed results (exclude _evalfile entries)
                    echo "\nDetailed Results:"
                    testResults.each { test, status ->
                        if (!test.endsWith('_evalfile')) {
                            def icon = status == "SUCCESS" ? "✅" : "❌"
                            echo "${icon} ${test}: ${status}"
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo 'Cleaning up and archiving artifacts...'
                
                // Archive all test results
                archiveArtifacts artifacts: 'tests/logs/**/*.json', allowEmptyArchive: true
                archiveArtifacts artifacts: 'tests/logs/**/*.jsonl', allowEmptyArchive: true
                archiveArtifacts artifacts: 'tests/logs/sessions/**/*', allowEmptyArchive: true
                
                echo 'Cleanup completed'
            }
        }
        success {
            echo '✅ Database Sweep Pipeline completed successfully!'
        }
        failure {
            echo '❌ Database Sweep Pipeline failed. Check logs for details.'
        }
    }
}