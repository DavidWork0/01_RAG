pipeline {
    agent {
        docker {
            image 'linux_with_cuda_complete:latest'
            args '--gpus all --entrypoint="" -v /var/jenkins_home/local_repo/data/output:/var/jenkins_home/workspace/RAG_inference_multimodel_multi_DB_test/data/output:ro'
            reuseNode true
        }
    }

    environment {
        GIT_CONFIG_PARAMETERS = 'core.autocrlf=false'
        HF_HOME = '/app/01_RAG/models/huggingface'
        HUGGINGFACE_HUB_CACHE = '/app/01_RAG/models/huggingface'
        TRANSFORMERS_CACHE = '/app/01_RAG/models/huggingface'
        RAG_MODEL_CACHE_DIR = '/app/01_RAG/models/huggingface'
        RAG_PROJECT_ROOT_OVERRIDE = '/app/01_RAG'
        RAG_LLM_MODELS_DIR = '/app/01_RAG/models/llamacpp'
        WORKDIR = '/app/01_RAG/tests'
        
        NEPTUNE_API_TOKEN = credentials('neptune-api-token')
        NEPTUNE_PROJECT = 'davidwork0/rag-tests'
        NEPTUNE_UPLOAD_MODE = 'latest'
    }

    stages {
        stage('Verify Environment') {
            steps {
                script {
                    echo '🔍 Verifying database paths and environment...'
                    sh '''
                        echo "=== Current working directory ==="
                        pwd
                        echo ""
                        echo "=== Checking workspace data/output ==="
                        ls -la data/output/ || echo "❌ data/output not found in workspace"
                        echo ""
                        echo "=== Checking /var/jenkins_home/workspace/RAG_inference_multimodel_multi_DB_test/data/output ==="
                        ls -la /var/jenkins_home/workspace/RAG_inference_multimodel_multi_DB_test/data/output/ || echo "❌ Not found"
                        echo ""
                        echo "=== Checking /var/jenkins_home/local_repo/data/output ==="
                        ls -la /var/jenkins_home/local_repo/data/output/ || echo "❌ Not found"
                        echo ""
                        echo "=== All mount points ==="
                        mount | grep jenkins || echo "No jenkins mounts"
                    '''
                }
            }
        }
        
        stage('Install rouge-score') {
            steps {
                script {
                    echo 'Installing rouge-score package...'
                    sh '/app/01_RAG/.venv/bin/pip install rouge-score'
                }
            }
        }

        stage('Database Sweep Testing') {
            steps {
                script {
                    // Define databases to test
                    def databases_all = [
