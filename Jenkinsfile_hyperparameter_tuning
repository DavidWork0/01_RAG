pipeline {
    agent {
        docker {
            // Use the project's existing image which has all dependencies and CUDA support
            image 'linux_with_cuda_complete:latest'
            // Pass GPU access to the container
            args '--gpus all --entrypoint=""'
            reuseNode true
        }
    }

    environment {
        // Ensure all huggingface caches resolve to the baked-in models
        GIT_CONFIG_PARAMETERS = 'core.autocrlf=false'
        HF_HOME = '/app/01_RAG/models/huggingface'
        HUGGINGFACE_HUB_CACHE = '/app/01_RAG/models/huggingface'
        TRANSFORMERS_CACHE = '/app/01_RAG/models/huggingface'
        RAG_MODEL_CACHE_DIR = '/app/01_RAG/models/huggingface'
        RAG_PROJECT_ROOT_OVERRIDE = '/app/01_RAG'
        RAG_LLM_MODELS_DIR = '/app/01_RAG/models/llamacpp'
        WORKDIR = '/app/01_RAG/src'
        
        // Neptune.ai configuration (required for hyperparameter tuning results)
        NEPTUNE_API_TOKEN = credentials('neptune-api-token')
        NEPTUNE_PROJECT = 'davidwork0/rag-tests'
        
        // Hyperparameter tuning mode
        // Options: 'quick' (3 experiments), 'chunk_size' (20 experiments), 'batch_size' (5 experiments)
        TUNING_MODE = 'chunk_size'
    }

    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    echo '========================================='
                    echo 'HYPERPARAMETER TUNING PIPELINE'
                    echo '========================================='
                    echo "Tuning Mode: ${env.TUNING_MODE}"
                    echo "Neptune Project: ${env.NEPTUNE_PROJECT}"
                    echo '========================================='
                }
            }
        }
        
        stage('Install Neptune') {
            steps {
                script {
                    echo 'Installing Neptune.ai package...'
                    sh '/app/01_RAG/.venv/bin/pip install neptune'
                }
            }
        }
        
        stage('Run Hyperparameter Tuning') {
            steps {
                script {
                    echo "Running hyperparameter tuning in mode: ${env.TUNING_MODE}"
                    echo 'This will test multiple configurations and upload results to Neptune.ai'
                    echo ''
                    
                    // Run the Neptune-integrated hyperparameter tuner
                    sh """
                        cd /app/01_RAG/src
                        /app/01_RAG/.venv/bin/python hyperparameter_tuner_neptune.py \
                            --mode ${env.TUNING_MODE}
                    """
                }
            }
        }
        
        stage('Generate Summary Report') {
            steps {
                script {
                    echo 'Generating summary report from results...'
                    
                    // Find the latest tuning session JSON
                    sh """
                        cd /app/01_RAG
                        LATEST_JSON=\$(ls -t tests/logs/hyperparameter_tuning/tuning_session_*.json 2>/dev/null | head -1)
                        
                        if [ -n "\$LATEST_JSON" ]; then
                            echo "Latest tuning session: \$LATEST_JSON"
                            echo ""
                            echo "=== SUMMARY ==="
                            /app/01_RAG/.venv/bin/python -c "
import json
import sys

with open('\$LATEST_JSON', 'r') as f:
    data = json.load(f)

print(f'Total Experiments: {data[\"total_experiments\"]}')
successful = [r for r in data['results'] if r['status'] == 'success']
failed = [r for r in data['results'] if r['status'] != 'success']
print(f'Successful: {len(successful)}')
print(f'Failed: {len(failed)}')

if successful:
    print('')
    print('Top 3 Fastest Configurations:')
    sorted_by_time = sorted(successful, key=lambda x: x.get('duration_seconds', float('inf')))[:3]
    for i, result in enumerate(sorted_by_time, 1):
        print(f'  {i}. {result[\"name\"]}')
        print(f'     Duration: {result.get(\"duration_seconds\", \"N/A\"):.2f}s')
        params = result['parameters']
        for k, v in params.items():
            print(f'       {k}: {v}')
        if result.get('metrics'):
            print(f'       Total Chunks: {result[\"metrics\"].get(\"total_chunks\", \"N/A\")}')
            print(f'       Avg Chunk Size: {result[\"metrics\"].get(\"chunk_size_avg\", \"N/A\")}')
        print('')
"
                        else
                            echo "No tuning results found"
                        fi
                    """
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo 'Archiving results...'
                
                // Archive tuning results as Jenkins artifacts
                archiveArtifacts artifacts: 'tests/logs/hyperparameter_tuning/**/*.json', allowEmptyArchive: true
                archiveArtifacts artifacts: 'tests/logs/embeddings/**/*.log', allowEmptyArchive: true
                
                echo '========================================='
                echo 'HYPERPARAMETER TUNING COMPLETE'
                echo '========================================='
                echo ''
                echo 'Results have been uploaded to Neptune.ai'
                echo "View your results at: https://app.neptune.ai/${env.NEPTUNE_PROJECT}"
                echo ''
                echo 'Local results saved to: tests/logs/hyperparameter_tuning/'
                echo '========================================='
            }
        }
        success {
            echo '✅ Hyperparameter tuning pipeline completed successfully!'
        }
        failure {
            echo '❌ Hyperparameter tuning pipeline failed. Check logs for details.'
        }
    }
}
